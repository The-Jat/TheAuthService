# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 32
PUBLIC_URL=https://auth.thejat.in
BRAND_NAME=TheJat Accounts
BRAND_SHORT=TheJat

# Your own email: it becomes an administrator once verified.
ADMIN_EMAILS=you@example.com
# Set to false once the accounts you need exist, if you want a closed system.
ALLOW_SIGNUP=true
# Extra browser origins allowed to call /api (only SPAs that call userinfo directly).
CORS_ORIGINS=

POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
LOGGER_DB_PASSWORD=
NOTIFIER_DB_PASSWORD=
RABBITMQ_PASSWORD=
INTERNAL_API_KEY=

# Outgoing email (Amazon SES, Brevo, Mailtrap, …). Leave SMTP_HOST empty to skip sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TheJat Accounts <no-reply@thejat.in>

LOG_RETENTION_DAYS=30
